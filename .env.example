# Database connection string
# Docker compose default: mysql://b2b_user:b2b_pass@mysql:3306/b2b_catalog
# Local host access (outside Docker): mysql://b2b_user:b2b_pass@127.0.0.1:3308/b2b_catalog
DATABASE_URL=mysql://b2b_user:b2b_pass@127.0.0.1:3308/b2b_catalog

# Auth secret
JWT_SECRET=super-secret-key-change-me

# App settings
NODE_ENV=production
PORT=3000
